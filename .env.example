# Copy to .env and fill in the values from your app registration
# (Entra admin center -> App registrations -> your app -> Overview / Certificates & secrets).
# Point this ONLY at a test tenant during development.
# The client secret is a tenant-wide credential: keep this file out of synced
# folders, readable only by you, and rotate the secret before it expires.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret-here
